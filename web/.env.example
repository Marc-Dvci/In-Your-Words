# Copy to web/.env.local. Every variable the web app reads. Without them, the app runs in replay mode.
# Firebase web app config (Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check: a Fraud Defense (reCAPTCHA Enterprise) site key registered for the web app.
VITE_RECAPTCHA_SITE_KEY=
# App Check debug token for local development (register it in the console), or "true" to have one printed.
VITE_APPCHECK_DEBUG=
# Absolute URL of the hosted site, for the link card image.
VITE_PUBLIC_URL=
