{
  "name": "In Your Words",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "postStartCommand": "nohup bash -c 'npm run dev -w web -- --host 0.0.0.0 > /tmp/web.log 2>&1 &'",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "In Your Words",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
